# Google Workspace (service account with domain-wide delegation)
GOOGLE_SERVICE_ACCOUNT_KEY=./service-account.json
GOOGLE_ADMIN_EMAIL=admin@ameriglide.com

# Org unit new users are created in. Org units are per-tenant: "/Exempt from MFA"
# exists in the AmeriGlide Workspace, but a different tenant may not have it, and
# Google rejects users.insert against an OU that does not exist. Unset = that
# AmeriGlide default.
# ONBOARD_ORG_UNIT_PATH=/Exempt from MFA

# bin/onboard picks its steps per tenant from DOMAIN (below), not from which
# of these are set: on ameriglide.com, Amberjack and Phenix are required (a
# missing URL fails the run) and Sonar/PBX are skipped; on any other tenant,
# Sonar and PBX are required and Amberjack/Phenix are skipped when unset.

# Amberjack DB (required on ameriglide.com)
AMBERJACK_DATABASE_URL=postgresql://aj:PASSWORD@host:25060/aj?sslmode=require

# Phenix DB (required on ameriglide.com)
PHENIX_DATABASE_URL=postgresql://phenix:PASSWORD@host:25060/phenix?sslmode=require

# Sonar DB (IAI CRM). The live data is the `cg2` database, NOT one named
# "sonar". Required on a non-ameriglide.com tenant (missing = the run fails);
# ignored on ameriglide.com, so an AmeriGlide checkout leaves it unset.
# SONAR_DATABASE_URL=postgresql://USER:PASSWORD@host:5432/cg2?sslmode=require

# IAI PBX (softphone). Required (PBX_HOST) on a non-ameriglide.com tenant;
# ignored on ameriglide.com.
# The host is deployment topology, so it lives here and never in the repo.
# Agents register over SIP-TLS with mandatory SRTP, on the public internet --
# do NOT point a softphone at the PBX's tailnet address.
PBX_HOST=
PBX_TLS_PORT=5061

# Extensions actually enabled on the PBX, comma-separated. Migrated extensions
# default to a disabled endpoint template and cannot register, so onboarding a
# new agent needs someone to enable theirs server-side first. A listed-as-
# disabled extension is refused before the Sonar row is written. Unset = skip
# the check rather than block on a stale list.
PBX_ENABLED_EXTENSIONS=

# 1Password item holding one SIP password per extension (field label =
# extension). All three must be set for bin/onboard to fill the password into
# the generated MicroSIP account sheet; with none set it prints a placeholder.
# Setting only one or two of the three is a config error.
PBX_OP_ITEM=
PBX_OP_VAULT=
PBX_OP_ACCOUNT=

# Twilio
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WORKSPACE_SID=WS...
TWILIO_CREDENTIAL_LIST_SID=CL...
TWILIO_TWIML_APP_SID=AP...

# AES-256 encryption key (base64-encoded, 32 bytes decoded)
AES_KEY=

# Tailscale (used by bin/copy).
# NOT set here any more: bin/copy regenerates this key and writes it to the
# 1Password item ag-admin-runtime, so a copy in .env only goes stale. Listed
# for reference; read it with
#   op item get ag-admin-runtime --vault ag-admin-runtime \
#      --account ameriglide.1password.com --fields label=TAILSCALE_AUTH_KEY --reveal
# TAILSCALE_AUTH_KEY=

# DigitalOcean ORG-LEVEL API token (used by bin/cost-allocation).
# Billing is NOT readable by regular team/user PATs (they 403 on
# /v2/customers/my/*, doctl included). Mint this in the cloud panel under the
# Organization's API settings, where "billing" is the only grantable scope.
DO_BILLING_TOKEN=

# Zoiper Pro license (used by setup-zoiper.ps1 and setup-workstation.ps1)
ZOIPER_USERNAME=
ZOIPER_PASSWORD=

# Office Wi-Fi — passed to deploy-gcpw.ps1 so the all-user profile is in place
# pre-login on fresh Win11 boxes (required for GCPW to reach Google at sign-in).
WIFI_SSID=
WIFI_PASSWORD=

# Google Workspace domain for the tenant this checkout serves
# (ameriglide.com, inetalliance.net, etc.). Used by bin/copy, bin/onboard,
# bin/reset-user to derive user@<domain> emails and the GCPW SAM-account
# suffix (<localpart>_<domain-no-tld>). Passed through to setup-workstation.ps1
# for Chrome site-permission allowlists.
DOMAIN=ameriglide.com

# Brand label used for company-branded paths created by setup-workstation.ps1:
# C:\ProgramData\<BRAND> for the chrome/RDP launcher scripts, and
# $env:LOCALAPPDATA\.<brand-lower>-2sv-prompted for the per-user 2SV flag.
# Also used as the display name for the storefront bookmark on the Chrome
# bookmark bar. Stays in user-visible places (login auto-start, desktop
# shortcut, bookmark) so the UX feels native to whichever company the
# machine belongs to. Avoid spaces — directory name uses this verbatim.
BRAND=AmeriGlide

# Marketing/storefront URL for the company bookmark on the Chrome bar.
# AmeriGlide -> https://www.ameriglide.com, iai -> https://www.usmedicalsupplies.com.
MARKETING_URL=https://www.ameriglide.com

# Twilio PSTN subdomain used in agent SIP URIs (e.g. user@<tenant>.pstn.twilio.com).
# Only relevant if bin/onboard is wiring up Twilio for this tenant.
TWILIO_PSTN_DOMAIN=ameriglide.pstn.twilio.com

# Role -> Google Group bundles used by bin/onboard's "Google Groups" step and by
# bin/groups. JSON object: role name -> array of group tokens. Short tokens (no
# domain, or a trailing "@") expand to <localpart>@$DOMAIN, so the same config
# works across tenants. Unset -> the onboarding Google Groups step is skipped.
# ONBOARD_ROLES='{"Role Name":["staff@","some-group@"],"Another Role":["staff@","other-group@"]}'

# Optional: comma-separated "broad" (everyone-style) groups excluded from the
# bin/groups audit drift comparison. Defaults to "staff@".
# ONBOARD_BROAD_GROUPS=staff@

# Action1 (cloud RMM: remote management + patch management). Used by bin/copy +
# setup-workstation.ps1. CLIENT_ID/SECRET authenticate to the Action1 REST API (automation);
# the per-fleet agent installer URLs come from the Action1 console (Endpoints -> Add Endpoint).
# All carry org-specific ids, so real values live in .env (gitignored), not in this public repo.
ACTION1_CLIENT_ID=
ACTION1_CLIENT_SECRET=
ACTION1_AGENT_URL_AMERIGLIDE=
ACTION1_AGENT_URL_IAI=

# AWS SSM hybrid activation (used by bin/copy + setup-workstation.ps1 to enroll a
# workstation as an SSM managed instance for SSM-style remote command/debug). Mint with
# `aws ssm create-activation` against a role trusting ssm.amazonaws.com. Account-level
# (not per-fleet).
# NOT set here any more: these are rotated on the 1st and 15th by the k8s
# CronJob ops/k8s/ssm-rotate, which writes them to the 1Password item
# ag-admin-runtime. Anything reading them from .env gets whatever was true at
# the last rotation it happened to see. bin/copy reads the item directly.
#   op item get ag-admin-runtime --vault ag-admin-runtime \
#      --account ameriglide.1password.com --fields label=SSM_ACTIVATION_ID --reveal
# SSM_ACTIVATION_ID=
# SSM_ACTIVATION_CODE=
SSM_REGION=
# Other checkouts whose .env should also get the rotated activation (bin/rotate-ssm-activation).
# Space-separated user@host:/path/to/.env entries (updated over ssh + sudo). Topology -> .env only.
SSM_ROTATE_PEERS=
