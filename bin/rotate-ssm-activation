#!/usr/bin/env bash
#
# Rotate the AWS SSM hybrid activation(s).
#
# SSM hybrid activations expire after at most 30 days (AWS hard limit), so the
# activation baked into workstation onboarding (setup-workstation.ps1 -Only ssm,
# and the full "Set up workstation" run) must be refreshed ~monthly or new boxes
# will install the agent but fail to register.
#
# This mints a fresh activation, upserts SSM_ACTIVATION_ID/CODE into the
# 1Password item ag-admin-runtime (the mounted .env is a read-only FIFO) and
# rewrites any peer .env files (SSM_ROTATE_PEERS), then deletes the previous one.
# Already-registered instances are unaffected by the old one's deletion.
#
# Two fleets:
#   work     — SSM_ACTIVATION_ID/CODE, instance name amg-workstation, synced to peers
#   personal — SSM_ACTIVATION_ID_PERSONAL/CODE_PERSONAL, instance name
#              personal-machine, 1Password only (peers do not get it)
#
# Usage: ./bin/rotate-ssm-activation             # work fleet (+ personal, if seeded)
#        ./bin/rotate-ssm-activation --personal  # personal fleet only (also bootstraps
#                                                #   the _PERSONAL vars into 1Password)
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
ENV_FILE="$SCRIPT_DIR/.env"
[[ -e "$ENV_FILE" ]] || { echo "no .env in $SCRIPT_DIR" >&2; exit 1; }

# Where the rotated activations live. The mounted .env is a read-only FIFO and
# 1Password Environments cannot be written outside the desktop app, so the
# writable half is an item in its own vault.
#
# Auth is whatever op already has: the desktop app when a human runs this, or
# OP_SERVICE_ACCOUNT_TOKEN when the scheduler does. Passing --account is
# harmless under both, so there is one invocation form rather than two.
OP_ACCOUNT_AG="${OP_ACCOUNT_AG:-ameriglide.1password.com}"
OP_RUNTIME_VAULT="${OP_RUNTIME_VAULT:-ag-admin-runtime}"
OP_RUNTIME_ITEM="${OP_RUNTIME_ITEM:-ag-admin-runtime}"

# .env may be a regular file (old style: sourced, quoted values) or the
# 1Password-mounted FIFO (unquoted values, read-only).
_env_vars_read=0
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  . "$ENV_FILE"
  set +a
  _env_vars_read=$(grep -cE '^[[:space:]]*[A-Za-z_][A-Za-z0-9_]*=' "$ENV_FILE" || true)
elif [[ -e "$ENV_FILE" ]]; then
  while IFS= read -r _line; do
    case "$_line" in \#*|'') continue ;; esac
    case "$_line" in *=*)
      export "${_line%%=*}=${_line#*=}"
      _env_vars_read=$((_env_vars_read + 1)) ;;
    esac
  done < "$ENV_FILE"
  unset _line
fi

# The 1Password FIFO serves nothing when the app is locked or not running, and
# because every value it carries has a silent fallback, the script would go on
# to do a half-rotation and exit 0. That is exactly what happened on
# 2026-08-01: SSM_ROTATE_PROFILE fell back to ag-aws-admin (which exists, so
# the mint succeeded), SSM_ROTATE_PEERS was empty so the peer loop ran zero
# times without printing its WARN, and SSM_ACTIVATION_ID was empty so the
# previous activation was never deleted. Alan's box kept an expired activation
# for three weeks and nothing reported an error. Refuse to run on an empty
# config rather than guess which variable mattered.
if [[ -e "$ENV_FILE" && "$_env_vars_read" -eq 0 ]]; then
  {
    echo "ERROR: $ENV_FILE yielded no variables."
    echo "  If this is the 1Password-mounted FIFO, 1Password is locked or not running."
    echo "  Refusing to rotate: the AWS profile, the peer list and the previous"
    echo "  activation id would all be silently empty, producing a half-done"
    echo "  rotation that still exits 0."
  } >&2
  exit 1
fi
# Load the runtime item on top of .env, so its live values beat any stale copy
# of the same key still sitting in the Environment.
_item_vars_read=0
_load_op_runtime() {
  command -v op >/dev/null 2>&1 || { echo "ERROR: op (1Password CLI) not found" >&2; return 1; }
  local json kv
  json=$(op item get "$OP_RUNTIME_ITEM" --vault "$OP_RUNTIME_VAULT" \
           --account "$OP_ACCOUNT_AG" --format json --reveal 2>&1) || {
    echo "ERROR: could not read $OP_RUNTIME_VAULT/$OP_RUNTIME_ITEM:" >&2
    printf '  %s\n' "$json" >&2
    return 1
  }
  kv=$(printf '%s' "$json" | jq -r '
    .fields[]
    | select(.id != "notesPlain")
    | select(.value != null and .value != "")
    | ((.label // .id) + "=" + .value)') || return 1
  while IFS= read -r _l; do
    [[ -z "$_l" ]] && continue
    export "${_l%%=*}=${_l#*=}"
    _item_vars_read=$((_item_vars_read + 1))
  done <<< "$kv"
  unset _l
}
_load_op_runtime || exit 1

# Same reasoning as the .env guard above: the previous activation id now comes
# from the item, so an empty read there is just as dangerous as an empty .env.
if [[ "$_item_vars_read" -eq 0 ]]; then
  {
    echo "ERROR: $OP_RUNTIME_VAULT/$OP_RUNTIME_ITEM yielded no fields."
    echo "  Refusing to rotate: the previous activation id would be empty, so the"
    echo "  old activation would silently survive and peers would go unupdated."
  } >&2
  exit 1
fi

PROFILE="${SSM_ROTATE_PROFILE:-ag-aws-admin}"   # AWS CLI profile with create/delete-activation
ROLE="${SSM_ROTATE_ROLE:-ssm-hybrid-role}"      # IAM role trusting ssm.amazonaws.com
REGION="${SSM_REGION:-us-east-1}"

# Max 30-day expiry (GNU date fallback for non-macOS schedulers).
EXP=$(date -u -v+30d '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || date -u -d '+30 days' '+%Y-%m-%dT%H:%M:%S')

# Upsert VAR=value into the 1Password runtime item. `runtime` is the section
# id; [password] makes the field concealed. The value passes through argv,
# which is visible to other processes on the box for the duration of the call
# -- accepted because op item edit --template requires a full read-modify-write
# of the item, and because the same value is about to be written to a peer .env
# over ssh anyway.
_upsert_item() {
  local var="$1" val="$2"
  op item edit "$OP_RUNTIME_ITEM" --vault "$OP_RUNTIME_VAULT" \
    --account "$OP_ACCOUNT_AG" "runtime.${var}[password]=${val}" >/dev/null
}

# Rewrite VAR='value' pairs in a peer .env (local path, or user@host:/path over
# ssh) — substitute-only, no append; peers still keep plain quoted .env files.
# Brace-delimited perl so the base64 code's '/' chars don't clash.
_update_peer() {
  local target="$1" idvar="$2" nid="$3" codevar="$4" ncode="$5"
  local prog="s{^${idvar}=.*}{${idvar}='$nid'}; s{^${codevar}=.*}{${codevar}='$ncode'}"
  if [[ "$target" == *:* ]]; then
    local hp="${target%%:*}" path="${target#*:}" user host
    user="${hp%@*}"; host="${hp#*@}"
    ssh -o ConnectTimeout=15 "$host" "sudo -nH -u $user perl -i -pe \"$prog\" '$path'"
  else
    perl -i -pe "$prog" "$target"
  fi
}

# Mint a fresh activation for one fleet, save it, delete the fleet's old one.
_rotate_fleet() {
  local suffix="$1" name="$2" desc="$3" limit="$4" peers="$5"
  local idvar="SSM_ACTIVATION_ID${suffix}" codevar="SSM_ACTIVATION_CODE${suffix}"
  local old_id="${!idvar:-}"

  echo "Minting new SSM activation (name=$name, role=$ROLE, limit=$limit, region=$REGION)..."
  local json nid ncode
  json=$(aws ssm create-activation --profile "$PROFILE" --region "$REGION" \
    --iam-role "$ROLE" --registration-limit "$limit" --expiration-date "$EXP" \
    --default-instance-name "$name" \
    --description "$desc (rotated $(date -u +%Y-%m-%d))" --output json)
  nid=$(printf '%s' "$json" | jq -r '.ActivationId // empty')
  ncode=$(printf '%s' "$json" | jq -r '.ActivationCode // empty')
  [[ -n "$nid" && -n "$ncode" ]] || { echo "mint failed: $json" >&2; return 1; }
  echo "  new activation $nid (expires $EXP)"

  echo "Updating stored activation..."
  _upsert_item "$idvar" "$nid"
  _upsert_item "$codevar" "$ncode"
  echo "  updated 1Password $OP_RUNTIME_VAULT/$OP_RUNTIME_ITEM"
  # shellcheck disable=SC2086  # intentional word-split of the space-separated peer list
  for peer in $peers; do
    if _update_peer "$peer" "$idvar" "$nid" "$codevar" "$ncode"; then echo "  updated $peer"
    else echo "  WARN: could not update $peer (rotate it manually)" >&2; fi
  done

  # Delete the previous activation (registered mi- instances keep working).
  # An empty old_id is legitimate on a first run and a leak on every other one,
  # so say which happened instead of skipping in silence.
  if [[ -n "$old_id" && "$old_id" != "$nid" ]]; then
    aws ssm delete-activation --profile "$PROFILE" --region "$REGION" --activation-id "$old_id" \
      && echo "Deleted previous activation $old_id"
  elif [[ -z "$old_id" ]]; then
    echo "  WARN: no previous $idvar was set, so no old activation was deleted." >&2
    echo "        Expected on a first run; otherwise check for orphans with" >&2
    echo "        aws ssm describe-activations --profile $PROFILE --region $REGION" >&2
  fi
}

if [[ "${1:-}" == "--personal" ]]; then
  _rotate_fleet "_PERSONAL" personal-machine "Personal machines" \
    "${SSM_ROTATE_LIMIT_PERSONAL:-5}" ""
else
  _rotate_fleet "" amg-workstation "AmeriGlide workstations" \
    "${SSM_ROTATE_LIMIT:-100}" "${SSM_ROTATE_PEERS:-}"
  # Keep the personal activation fresh too once it has been bootstrapped, so
  # the monthly rotation covers both fleets.
  if [[ -n "${SSM_ACTIVATION_ID_PERSONAL:-}" ]]; then
    _rotate_fleet "_PERSONAL" personal-machine "Personal machines" \
      "${SSM_ROTATE_LIMIT_PERSONAL:-5}" ""
  fi
fi
echo "Done."
