#!/usr/bin/env bun

// Scan recently created mem0 memories for stored credentials.
//
// Read-only: it lists memories and reports. It never prints a secret value,
// only the memory id, its owner, the rule that matched and the first four
// characters of the match.
//
// Cost: one list request per 100 memories in the window, plus a few to split
// busy windows. No search or model calls.

import "../src/lib/load-env"; // must be first: loads repo-root .env regardless of cwd
import { parseArgs } from "util";
import { scanText, type Finding } from "../src/mem0-scan/patterns";

const BASE = "https://api.mem0.ai";
const PAGE_SIZE = 100;
const OFFSET_CAP = 2000; // mem0 refuses offset paging past this many rows

const { values } = parseArgs({
  args: Bun.argv.slice(2),
  options: {
    days: { type: "string", default: "8" },
    notify: { type: "boolean", default: false },
    help: { type: "boolean", default: false },
  },
  strict: true,
});

if (values.help) {
  console.log(
    [
      "Usage: bin/mem0-secret-scan [--days N] [--notify]",
      "  --days N   look at memories created in the last N days (default 8)",
      "  --notify   also raise a macOS notification with the result",
      "Exit status: 0 clean, 1 findings, 2 error.",
    ].join("\n"),
  );
  process.exit(0);
}

const key = process.env.MEM0_API_KEY;
if (!key) {
  console.error("MEM0_API_KEY is not set (expected in the repo .env).");
  process.exit(2);
}

interface Memory {
  id: string;
  memory?: string;
  user_id?: string | null;
  agent_id?: string | null;
  app_id?: string | null;
  created_at?: string;
}

let requests = 0;

async function page(gte: string, lt: string, n: number): Promise<{ count: number; results: Memory[] }> {
  const body = {
    filters: {
      AND: [
        { OR: [{ user_id: "*" }, { agent_id: "*" }, { app_id: "*" }, { run_id: "*" }] },
        { created_at: { gte, lt } },
      ],
    },
  };
  for (let attempt = 1; ; attempt++) {
    requests++;
    const res = await fetch(`${BASE}/v2/memories/?page=${n}&page_size=${PAGE_SIZE}`, {
      method: "POST",
      headers: { Authorization: `Token ${key}`, "Content-Type": "application/json" },
      body: JSON.stringify(body),
    });
    if (res.ok) {
      const json = (await res.json()) as { count?: number; results?: Memory[] };
      return { count: json.count ?? 0, results: json.results ?? [] };
    }
    if (attempt >= 5 || (res.status < 500 && res.status !== 429)) {
      throw new Error(`mem0 list failed: HTTP ${res.status} ${(await res.text()).slice(0, 200)}`);
    }
    await Bun.sleep(1000 * attempt);
  }
}

/** All memories created in [from, to). Splits the window when it holds more rows than offset paging allows. */
async function fetchWindow(from: Date, to: Date, seen: Map<string, Memory>): Promise<number> {
  const first = await page(from.toISOString(), to.toISOString(), 1);
  if (first.count > OFFSET_CAP && to.getTime() - from.getTime() > 1000) {
    const mid = new Date((from.getTime() + to.getTime()) / 2);
    return (await fetchWindow(from, mid, seen)) + (await fetchWindow(mid, to, seen));
  }
  for (const m of first.results) seen.set(m.id, m);
  const pages = Math.ceil(Math.min(first.count, OFFSET_CAP) / PAGE_SIZE);
  for (let n = 2; n <= pages; n++) {
    for (const m of (await page(from.toISOString(), to.toISOString(), n)).results) seen.set(m.id, m);
  }
  return first.count;
}

function notify(message: string) {
  if (!values.notify || process.platform !== "darwin") return;
  Bun.spawnSync(["osascript", "-e", `display notification ${JSON.stringify(message)} with title "mem0 secret scan"`]);
}

try {
  const days = Number(values.days);
  if (!Number.isFinite(days) || days <= 0) throw new Error("--days must be a positive number");
  const to = new Date();
  const from = new Date(to.getTime() - days * 86_400_000);

  const seen = new Map<string, Memory>();
  const expected = await fetchWindow(from, to, seen);

  const hits: { m: Memory; findings: Finding[] }[] = [];
  for (const m of seen.values()) {
    const findings = scanText(m.memory ?? "");
    if (findings.length) hits.push({ m, findings });
  }

  console.log(
    `${new Date().toISOString()} scanned ${seen.size} of ${expected} memories created since ${from.toISOString()} (${requests} requests)`,
  );
  if (seen.size < expected) {
    console.log(`WARNING: ${expected - seen.size} memories were reported but not returned, so they are unscanned.`);
  }
  for (const { m, findings } of hits) {
    const owner = m.user_id ?? m.agent_id ?? "?";
    for (const f of findings) {
      console.log(`HIT ${m.id} | ${owner} / ${m.app_id ?? "-"} | ${(m.created_at ?? "").slice(0, 10)} | ${f.rule} | ${f.hint}`);
    }
  }
  if (hits.length) {
    console.log(`${hits.length} memories need a look.`);
    notify(`${hits.length} memories may hold a credential. See the log.`);
    process.exit(1);
  }
  console.log("No credentials found.");
  notify(`Clean: ${seen.size} memories scanned.`);
} catch (err) {
  console.error(`mem0-secret-scan failed: ${(err as Error).message}`);
  notify("Scan failed. See the log.");
  process.exit(2);
}
